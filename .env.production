# ==============================================================================
# Wahide Frontend Production Environment Variables (.env.production)
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_NAME="Wahide"
NEXT_PUBLIC_APP_URL="https://wa.hidessh.com"
NEXT_PUBLIC_DEFAULT_LOCALE="id"

# Production Backend API Services (api-wa.hidessh.com)
NEXT_PUBLIC_API_BASE_URL="https://api-wa.hidessh.com/api/v1"
NEXT_PUBLIC_IAM_API_URL="https://api-wa.hidessh.com/api/v1"
NEXT_PUBLIC_WHATSAPP_API_URL="https://api-wa.hidessh.com/api/v1"
NEXT_PUBLIC_CAMPAIGN_API_URL="https://api-wa.hidessh.com/api/v1"
NEXT_PUBLIC_FINANCE_API_URL="https://api-wa.hidessh.com/api/v1"
NEXT_PUBLIC_TEMPLATE_API_URL="https://api-wa.hidessh.com/api/v1"
NEXT_PUBLIC_REMINDER_API_URL="https://api-wa.hidessh.com/api/v1"
NEXT_PUBLIC_RESERVATION_API_URL="https://api-wa.hidessh.com/api/v1"
NEXT_PUBLIC_FORM_API_URL="https://api-wa.hidessh.com/api/v1"

# Real-Time WebSocket / SSE Gateway
NEXT_PUBLIC_WS_GATEWAY_URL="wss://api-wa.hidessh.com/ws"

# Cloudflare Turnstile CAPTCHA Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAADOgaNLRGt1f6A6-"
TURNSTILE_SECRET_KEY="0x4AAAAAADOgaEsIKb-NTxKbqem-1NW0YUo"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DARK_MODE=true
